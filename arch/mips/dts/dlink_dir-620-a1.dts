#include "rt3050.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "dlink,dir-620-a1", "ralink,rt3050-soc";
	model = "D-Link DIR-620 A1";

	aliases {
		serial0 = &uartlite;
		ethernet0 = &eth_uboot; /* U-Boot uses this to find primary eth */
		led-boot = &led_power_green;
		led-failsafe = &led_wps_amber;
		led-running = &led_power_green;
		led-upgrade = &led_power_green;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x2000000>;
	};

	flash@1f000000 {
		compatible = "cfi-flash";
		reg = <0x1f000000 0x800000>;
		bank-width = <2>;
		device-width = <2>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

		partition@0 {
			label = "SPL";
			reg = <0x0 0x5E00>;
			read-only;
		};

		factory: partition@5E00 {
			label = "factory";
			reg = <0x5E00 0x200>;
			read-only;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				eeprom_factory_0: eeprom@0 {
					reg = <0x0 0x200>;
				};

				macaddr_factory_4: macaddr@4 {
					reg = <0x4 0x6>;
				};
			};
		};

		partition@6000 {
			label = "u-boot-env";
			reg = <0x6000 0x2000>;
		};

		partition@8000 {
			label = "u-boot";
			reg = <0x8000 0x28000>;
			read-only;
		};

#if CONFIG_DIR620_FIRMWARE_OFFSET == 0x30000
		partition@30000 {
#else
		partition@80000 {
#endif
			compatible = "denx,uimage";
			label = "firmware";
			reg = <CONFIG_DIR620_FIRMWARE_OFFSET CONFIG_DIR620_FIRMWARE_SIZE>;
		};
	};
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		wps {
			label = "wps";
			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	leds {
		compatible = "gpio-leds";

		power-amber {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_AMBER>;
			gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
		};

		led_power_green: power-green {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
		};

		wan-amber {
			function = LED_FUNCTION_WAN;
			color = <LED_COLOR_ID_AMBER>;
			gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
		};

		wan-green {
			function = LED_FUNCTION_WAN;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;
		};

		wps-blue {
			function = LED_FUNCTION_WPS;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
		};

		led_wps_amber: wps-amber {
			function = LED_FUNCTION_WPS;
			color = <LED_COLOR_ID_AMBER>;
			gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
		};
	};

	chosen {
		bootargs = "console=ttyS0,57600 rootfstype=squashfs,jffs2";
		stdout-path = "serial0:57600n8";
	};

	options {
		u-boot {
			compatible = "u-boot,config";
			boot-led = <&led_power_green>;
		};
	};

	eth_uboot: eth_uboot@10100000 { /* U-Boot */
		compatible = "u-boot,rt3052-eth";
		reg = <0x10100000 0x10000
		       0x10110000 0x8000>;
		resets = <&sysc 21>, <&sysc 23>;
		reset-names = "fe", "esw";
		nvmem-cells = <&macaddr_factory_4>;
		nvmem-cell-names = "mac-address";
		mediatek,poll-link-phy = <0>;
	};
};

&eth_linux { /* Linux */
	nvmem-cells = <&macaddr_factory_4>;
	nvmem-cell-names = "mac-address";
	status = "okay";
};

&esw { /* Linux */
	/*
	 * mediatek,portmap: bitmask where 1 = LAN, 0 = WAN
	 *   Port  0 (PHY0)  1  LAN
	 *   Port  1 (PHY1)  1  LAN
	 *   Port  2 (PHY2)  1  LAN
	 *   Port  3 (PHY3)  0  WAN
	 *   Port  4 (PHY4)  0  WAN
	 *   Port  5 (CPU)   1  LAN
	 *                   --  ---
	 *              0x27 = 0010_0111
	 */
	mediatek,portmap = <0x27>;
};

&wmac { /* shared */
	status = "okay";
	nvmem-cells = <&eeprom_factory_0>;
	nvmem-cell-names = "eeprom";
};

&otg { /* shared */
	status = "okay";
};

&uartlite { /* shared — clock-frequency is U-Boot-specific, harmless to Linux */
	clock-frequency = <128000000>;
};
